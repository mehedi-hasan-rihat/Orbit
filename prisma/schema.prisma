generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  password            String
  emailVerified       Boolean             @default(false)
  verificationToken   String?             @unique
  verificationExpiry  DateTime?
  passwordResetToken  String?             @unique
  passwordResetExpiry DateTime?
  theme               String              @default("system")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  applications        Application[]
  tags                Tag[]
  notifications       Notification[]
  stageTypes          PipelineStageType[]
}

enum StageOutcome {
  SCHEDULED
  ASSIGNED
  COMPLETED
  PASSED
  FAILED
  CANCELLED
}

model Application {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          String
  role             String
  jobUrl           String?
  stageId          String?
  stage            PipelineStageType? @relation(fields: [stageId], references: [id], onDelete: Restrict)
  appliedDate      DateTime?
  // archived: hidden from the active list, orthogonal to closed
  archived         Boolean            @default(false)
  // closed: process ended — keeps stageId intact so history is preserved
  closed           Boolean            @default(false)
  closedAt         DateTime?
  stageOutcome     StageOutcome?      // Sub-status of the current stage step
  stageScheduledAt DateTime?          // When the current stage step is scheduled
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  activities       Activity[]
  reminders        Reminder[]
  notes            Note[]
  tags             ApplicationTag[]

  @@index([userId])
  @@index([userId, stageId])
  @@index([userId, archived])
  @@index([userId, closed])
  @@index([company])
}

enum ActivityType {
  CREATED
  OUTCOME_CHANGE
  NOTE_ADDED
  REMINDER_SET
  OTHER
}

model Activity {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ActivityType
  description   String
  metadata      String?
  createdAt     DateTime     @default(now())

  @@index([applicationId])
}

model Tag {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String           @default("#6b7280")
  createdAt    DateTime         @default(now())
  applications ApplicationTag[]

  @@unique([userId, name])
  @@index([userId])
}

enum StageCategory {
  OPEN         // Not yet in process — Wishlist, Applied, Screening
  INTERVIEWING // Actively progressing — Assessment, Interview
  SUCCESS      // Final positive outcomes — Get Offer, Hired
  CLOSED       // Terminal — Rejected
}

model PipelineStageType {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String        @default("#6b7280")
  category     StageCategory @default(INTERVIEWING)
  order        Int           @default(0)
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@unique([userId, name])
  @@index([userId])
}

enum NotificationType {
  SCHEDULED
  REMINDER
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  body          String
  applicationId String?
  read          Boolean          @default(false)
  emailSent     Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Reminder {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  details       String?
  dueAt         DateTime
  done          Boolean     @default(false)
  doneAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@index([applicationId, done])
  @@index([dueAt])
}

model ApplicationTag {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([applicationId, tagId])
  @@index([applicationId])
  @@index([tagId])
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@index([applicationId, createdAt])
}
