generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  password            String
  emailVerified       Boolean       @default(false)
  verificationToken   String?       @unique
  verificationExpiry  DateTime?
  passwordResetToken  String?       @unique
  passwordResetExpiry DateTime?
  theme               String        @default("system")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  applications        Application[]
  tags                Tag[]
  notifications       Notification[]
  stageTypes          PipelineStageType[]
}

// Legacy application stage. Superseded by PipelineStageType.
enum ApplicationStatus {
  WISHLIST
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  ARCHIVED
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       String
  role          String
  jobUrl        String?
  stageId       String?
  stage         PipelineStageType? @relation(fields: [stageId], references: [id], onDelete: Restrict)
  status        ApplicationStatus? // Legacy — pre-pipeline rows only
  appliedDate   DateTime?
  notes         String?
  // Mirror of the soonest open FollowUp, kept in sync by the follow-up actions.
  // Denormalised on purpose: the list sort, the board and the dashboard all read
  // one date off the application, and a real follow-up now carries a title and
  // details of its own. Never written by hand — see src/lib/actions/follow-ups.ts.
  followUpDate  DateTime?
  resumeUrl     String?
  coverLetterUrl String?
  archived      Boolean           @default(false)
  // Closing ends the process without rewriting history: stageId, notes, tags
  // and interview rounds are all left exactly as they were, so a card that
  // died at "Technical Interview" still says so. Orthogonal to `archived`,
  // which is only about getting a row out of the list.
  closed        Boolean           @default(false)
  closedAt      DateTime?
  // An offer is an outcome, not a place in the pipeline. Same shape as
  // `closed`, but orthogonal to it: an offer you haven't answered is still a
  // live application, so this does not imply closed.
  offered       Boolean           @default(false)
  offeredAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  activities    Activity[]
  interviews    Interview[]
  followUps     FollowUp[]
  tags          ApplicationTag[]

  @@index([userId])
  @@index([userId, stageId])
  @@index([userId, archived])
  @@index([userId, closed])
  @@index([userId, offered])
  @@index([company])
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  FOLLOW_UP_SET
  INTERVIEW_SCHEDULED
  INTERVIEW_OUTCOME
  OTHER
}

model Activity {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ActivityType
  description   String
  metadata      String?      // JSON string for extra data
  createdAt     DateTime     @default(now())

  @@index([applicationId])
}

model Tag {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String           @default("#6b7280")
  createdAt    DateTime         @default(now())
  applications ApplicationTag[]

  @@unique([userId, name])
  @@index([userId])
}

enum StageCategory {
  OPEN          // not yet in process — Wishlist, Applied
  INTERVIEWING  // actively progressing through rounds
  SUCCESS       // Offer
  CLOSED        // Rejected, Withdrawn, Archived
}

// User-owned catalogue of interview stage types. Seeded with defaults on first
// read (see src/lib/actions/pipeline.ts) so existing users get a pipeline too.
model PipelineStageType {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String        @default("#6b7280")
  category     StageCategory @default(INTERVIEWING)
  order        Int           @default(0)
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  interviews   Interview[]
  applications Application[]

  @@unique([userId, name])
  @@index([userId])
}

// Legacy stage type. Superseded by PipelineStageType; kept nullable so rows
// written before the pipeline rework still render their original label.
enum InterviewType {
  PHONE_SCREEN
  ONSITE
  PANEL
  ASSESSMENT
  TASK
  FINAL
  OTHER
}

model Interview {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageTypeId   String?
  stageType     PipelineStageType? @relation(fields: [stageTypeId], references: [id], onDelete: SetNull)
  type          InterviewType?     // Legacy — pre-rework rows only
  customType    String?            // Free-form label: legacy OTHER rows, and the
                                   // snapshot taken when a stage type is deleted
  round         Int           @default(1)
  scheduledAt   DateTime?
  notes         String?
  outcome       String?       // One of INTERVIEW_OUTCOMES in src/lib/validations.ts
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([applicationId])
  @@index([stageTypeId])
}

enum NotificationType {
  INTERVIEW_REMINDER
  FOLLOW_UP_REMINDER
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  body          String
  applicationId String?
  read          Boolean          @default(false)
  emailSent     Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// A named thing to chase, with its own due date. Capped at MAX_ACTIVE_FOLLOW_UPS
// open per application (enforced in the action, not the schema — the limit is a
// product rule about what a person can usefully track, not an invariant the
// database needs to guarantee).
model FollowUp {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  details       String?
  dueAt         DateTime
  done          Boolean     @default(false)
  doneAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@index([applicationId, done])
  @@index([dueAt])
}

model ApplicationTag {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([applicationId, tagId])
  @@index([applicationId])
  @@index([tagId])
}
